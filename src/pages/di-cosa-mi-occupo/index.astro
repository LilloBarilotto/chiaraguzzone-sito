---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Section from '../../components/Section.astro';
import Card from '../../components/Card.astro';
import CtaBox from '../../components/CtaBox.astro';
import { pageTitle, breadcrumbLd } from '../../lib/seo';

const temi = (await getCollection('temi', (e) => !e.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  title={pageTitle('Di cosa mi occupo')}
  description="Ansia, autostima, difficoltà relazionali, sessualità, coppia e affettività: i temi di cui mi occupo come psicologa a Milano e online."
  jsonLd={breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Di cosa mi occupo', path: '/di-cosa-mi-occupo' }])}
>
  <Section title="Di cosa mi occupo" intro="Alcune delle situazioni con cui le persone mi contattano più spesso.">
    {temi.length === 0 && <p>Al momento non ci sono temi pubblicati: scrivimi per avere informazioni.</p>}
    <div class="grid grid--3">
      {temi.map((t) => (
        <Card title={t.data.title} href={`/di-cosa-mi-occupo/${t.id}`}>{t.data.excerpt}</Card>
      ))}
    </div>
    <div class="container--narrow"><CtaBox /></div>
  </Section>
</BaseLayout>
