---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBox from '../../components/CtaBox.astro';
import { pageTitle, breadcrumbLd, formatDate, personLd, SITE_URL, OG_DEFAULT } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', (e) => !e.data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );
  return posts.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, newer: posts[i - 1], older: posts[i + 1] },
  }));
}
const { entry, newer, older } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const path = `/blog/${entry.id}`;
const image = d.cover ?? OG_DEFAULT;
const jsonLd = [
  breadcrumbLd([{ name: 'Home', path: '/' }, { name: 'Blog', path: '/blog' }, { name: d.title, path }]),
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.title,
    description: d.description,
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    inLanguage: 'it-IT',
    mainEntityOfPage: `${SITE_URL}${path}`,
    image: new URL(image, SITE_URL).href,
    author: personLd,
    publisher: { '@id': `${SITE_URL}/#studio` },
    keywords: d.tags.join(', '),
  },
];
---
<BaseLayout title={pageTitle(d.title)} description={d.description} ogImage={image} jsonLd={jsonLd}>
  <article class="section">
    <div class="container container--narrow">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/blog">← Tutti gli articoli</a></nav>
      <header class="stack head">
        <h1>{d.title}</h1>
        <p class="meta muted">
          <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate)}</time>
          {d.updatedDate && <span> · aggiornato il <time datetime={d.updatedDate.toISOString()}>{formatDate(d.updatedDate)}</time></span>}
          <span> · di Dott.ssa Chiara Guzzone</span>
        </p>
        {d.tags.length > 0 && <ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul>}
      </header>
      {d.cover && <img class="cover" src={d.cover} alt={d.coverAlt ?? ''} width="1200" height="630" loading="eager" />}
      <div class="prose"><Content /></div>
      <CtaBox />
      {(newer || older) && (
        <nav class="pn" aria-label="Altri articoli">
          {older ? <a href={`/blog/${older.id}`}><small>← Precedente</small><span>{older.data.title}</span></a> : <span />}
          {newer ? <a href={`/blog/${newer.id}`} class="next"><small>Successivo →</small><span>{newer.data.title}</span></a> : <span />}
        </nav>
      )}
    </div>
  </article>
</BaseLayout>
<style>
  .crumbs { margin-bottom: var(--space-4); font-size: var(--text-sm); }
  .head { margin-bottom: var(--space-6); }
  .meta { font-size: var(--text-sm); }
  .tags { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .tags li { font-size: var(--text-sm); padding: 0.1rem 0.7rem; border-radius: 999px; background: var(--color-sage-soft); color: var(--color-sage-darker); }
  .cover { width: 100%; height: auto; border-radius: var(--radius); margin-bottom: var(--space-6); }
  .pn { display: grid; gap: var(--space-4); grid-template-columns: 1fr; margin-top: var(--space-7); }
  @media (min-width: 40rem) { .pn { grid-template-columns: 1fr 1fr; } }
  .pn a { display: flex; flex-direction: column; gap: var(--space-1); padding: var(--space-4); border: 1px solid var(--color-border); border-radius: var(--radius); text-decoration: none; }
  .pn small { color: var(--color-text-muted); }
  .pn .next { text-align: right; }
</style>
