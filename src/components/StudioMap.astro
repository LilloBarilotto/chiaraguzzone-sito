---
import { site } from '../data/site';
import { fullAddress } from '../lib/seo';

const studios = site.studios.map((s) => {
  const address = fullAddress(s);
  const q = encodeURIComponent(address);
  return {
    ...s,
    address,
    embed: `https://www.google.com/maps?q=${q}&output=embed`,
    google: `https://www.google.com/maps/search/?api=1&query=${q}`,
    apple: `https://maps.apple.com/?q=${q}`,
  };
});
---
<div class="studios">
  {studios.map((s) => (
    <article class="studio">
      <h3>{s.name}</h3>
      {s.primary && <p class="badge">Studio principale</p>}
      <address>{s.address}</address>
      <p class="muted">{s.note}</p>

      <div class="map" data-map>
        <iframe
          data-src={s.embed}
          title={`Mappa di ${s.name}`}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          hidden
        ></iframe>
        <div class="map-ph" data-map-ph>
          <p class="ph-text">Per vedere la mappa accetta i cookie di Google Maps.</p>
          <div class="ph-actions" data-map-actions hidden>
            <button type="button" class="btn btn--primary" data-map-accept>Accetta e mostra mappa</button>
            <button type="button" class="btn btn--secondary" data-map-once>Mostra solo questa volta</button>
          </div>
          <a href={s.google} target="_blank" rel="noopener noreferrer">Apri in Google Maps</a>
        </div>
      </div>
      <p class="map-links">
        <a href={s.apple} target="_blank" rel="noopener noreferrer">Apri in Apple Maps</a>
      </p>
    </article>
  ))}
</div>
{site.online && <p class="online">Ricevo anche <strong>online</strong>, per videocolloqui da dove preferisci.</p>}

<script>
  import { getConsent, setConsent, CONSENT_EVENT } from '../lib/consent';

  const boxes = Array.from(document.querySelectorAll<HTMLElement>('[data-map]'));

  const load = () => {
    boxes.forEach((box) => {
      const iframe = box.querySelector('iframe');
      const ph = box.querySelector<HTMLElement>('[data-map-ph]');
      if (!iframe || !ph) return;
      if (!iframe.getAttribute('src')) iframe.setAttribute('src', iframe.dataset.src ?? '');
      iframe.hidden = false;
      ph.hidden = true;
    });
  };
  const unload = () => {
    boxes.forEach((box) => {
      const iframe = box.querySelector('iframe');
      const ph = box.querySelector<HTMLElement>('[data-map-ph]');
      if (!iframe || !ph) return;
      iframe.removeAttribute('src');
      iframe.hidden = true;
      ph.hidden = false;
    });
  };

  boxes.forEach((box) => {
    box.querySelector<HTMLElement>('[data-map-actions]')?.removeAttribute('hidden');
    box.querySelector('[data-map-accept]')?.addEventListener('click', () => setConsent(true));
    // Solo questa volta: nessuna scelta salvata
    box.querySelector('[data-map-once]')?.addEventListener('click', load);
  });

  window.addEventListener(CONSENT_EVENT, (e) => {
    (e as CustomEvent<{ maps: boolean }>).detail.maps ? load() : unload();
  });
  if (getConsent() === true) load();
</script>

<style>
  .studios { display: grid; gap: var(--space-5); grid-template-columns: 1fr; }
  @media (min-width: 48rem) { .studios { grid-template-columns: repeat(2, 1fr); } }
  .studio {
    background: var(--color-surface); border: 1px solid var(--color-border);
    border-radius: var(--radius); padding: var(--space-5); min-width: 0;
  }
  address { font-style: normal; font-weight: 600; margin-top: var(--space-2); }
  .badge {
    display: inline-block; margin-top: var(--space-2); padding: 0.1rem 0.6rem; border-radius: 999px;
    background: var(--color-sage-soft); color: var(--color-sage-darker);
    font-size: var(--text-sm); font-weight: 600;
  }
  .map { margin-top: var(--space-4); aspect-ratio: 4 / 3; border-radius: var(--radius-sm); overflow: hidden; }
  @media (min-width: 52rem) { .map { aspect-ratio: 16 / 10; } }
  .map-ph {
    height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;
    gap: var(--space-3); text-align: center; padding: var(--space-4);
    background: var(--color-sage-soft); border: 1px solid var(--color-border); border-radius: var(--radius-sm);
    font-size: var(--text-sm);
  }
  .map-ph[hidden] { display: none; }
  .ph-text { max-width: 28ch; }
  .ph-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
  .ph-actions[hidden] { display: none; }
  .ph-actions .btn { min-height: 2.5rem; padding: 0.4rem 1rem; font-size: var(--text-sm); }
  .map iframe { width: 100%; height: 100%; border: 0; display: block; }
  .map iframe[hidden] { display: none; }
  .map-links { margin-top: var(--space-3); font-weight: 600; font-size: var(--text-sm); }
  .map-links a { display: inline-block; padding-block: 0.4rem; }
  .online { margin-top: var(--space-5); }
</style>
