---
interface Props {
  label?: string;
  ratio?: string; // es. "4 / 5", "16 / 9", "1 / 1"
  class?: string;
}
const { label = 'Foto in arrivo', ratio = '4 / 5', class: className = '' } = Astro.props;
---
<div class:list={['photo-ph', className]} style={`aspect-ratio: ${ratio}`} role="img" aria-label={label}>
  <span>{label}</span>
</div>
<style>
  .photo-ph {
    display: grid; place-items: center; width: 100%;
    background: linear-gradient(135deg, var(--color-sage-soft), var(--color-bg-alt));
    border: 1px dashed var(--color-sage); border-radius: var(--radius-lg);
    color: var(--color-sage-dark); font-family: var(--font-heading); font-size: var(--text-lg);
    text-align: center; padding: var(--space-4);
  }
</style>
